<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.joshuamc1.inventariomunicipal.controllers.dashboard.ProfileController"
      spacing="20" alignment="TOP_CENTER"
      style="-fx-padding: 30; -fx-background-color: white;">

    <Label text="Mi Perfil" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Separator prefWidth="500"/>

    <GridPane hgap="15" vgap="15" maxWidth="600">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="300" prefWidth="400"/>
        </columnConstraints>

        <!-- Nombre de usuario (solo lectura) -->
        <Label text="Nombre de usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtUsername" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   style="-fx-opacity: 0.7; -fx-background-color: #f0f0f0;"/>

        <!-- Rol (solo lectura) -->
        <Label text="Rol:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtRole" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"
                   style="-fx-opacity: 0.7; -fx-background-color: #f0f0f0;"/>

        <!-- Nombre completo (editable) -->
        <Label text="Nombre completo:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="2"
                   promptText="Ingrese su nombre completo"/>

        <!-- Separador para cambio de contraseña -->
        <Separator GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

        <Label text="Cambiar Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <!-- Contraseña actual -->
        <Label text="Contraseña actual:" GridPane.columnIndex="0" GridPane.rowIndex="5"
               style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtCurrentPassword" GridPane.columnIndex="1" GridPane.rowIndex="5"
                       promptText="Ingrese su contraseña actual"/>

        <!-- Nueva contraseña -->
        <Label text="Nueva contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="6"
               style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtNewPassword" GridPane.columnIndex="1" GridPane.rowIndex="6"
                       promptText="Mínimo 6 caracteres"/>

        <!-- Confirmar contraseña -->
        <Label text="Confirmar contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="7"
               style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtConfirmPassword" GridPane.columnIndex="1" GridPane.rowIndex="7"
                       promptText="Repita la nueva contraseña"/>

    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnSave" text="Guardar Cambios" onAction="#onSave"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30;"/>
        <Button text="Cancelar" onAction="#onCancel"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30;"/>
    </HBox>

    <Label fx:id="lblInfo" wrapText="true" maxWidth="600"
           style="-fx-text-fill: #666; -fx-font-size: 12px; -fx-text-alignment: center;"
           text="Nota: Deje los campos de contraseña vacíos si no desea cambiarla. Si cambia la contraseña, debe ingresar la actual."/>

</VBox>

