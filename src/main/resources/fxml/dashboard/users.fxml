<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.joshuamc1.inventariomunicipal.controllers.dashboard.UsersController">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Usuarios" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtSearch" promptText="Buscar por nombre o usuario" />
            <Button text="Buscar" onAction="#onSearch" />
            <Button text="Nuevo" onAction="#onNew" />
            <Button text="Editar" onAction="#onEdit" />
            <Button text="Restablecer contraseña" onAction="#onResetPassword" />
            <Button text="Eliminar" onAction="#onDelete" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="tblUsers">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colName" text="Nombre" prefWidth="180" />
                <TableColumn fx:id="colUsername" text="Usuario" prefWidth="160" />
                <TableColumn fx:id="colRole" text="Rol" prefWidth="120" />
                <TableColumn fx:id="colCreated" text="Creado" prefWidth="160" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Paginación:" />
            <Button text="Prev" onAction="#onPrev" />
            <Button text="Next" onAction="#onNext" />
        </HBox>
    </bottom>
</BorderPane>
