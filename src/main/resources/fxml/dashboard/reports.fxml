<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.joshuamc1.inventariomunicipal.controllers.dashboard.ReportsController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-alignment: center-left;">
            <Label text="Reportes" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRefresh" text="Refrescar" />
        </HBox>
    </top>

    <left>
        <VBox spacing="8" style="-fx-padding: 10;" fx:id="menuBox">
            <Label text="Seleccionar reporte:" />
            <ListView fx:id="lstReports" prefWidth="220" />
        </VBox>
    </left>

    <center>
        <VBox spacing="8" style="-fx-padding: 10;">
            <HBox spacing="10">
                <Label text="Filtros:" />
                <Label text="Desde:" />
                <DatePicker fx:id="dpFrom" />
                <Label text="Hasta:" />
                <DatePicker fx:id="dpTo" />
                <Button fx:id="btnRun" text="Generar" />
                <Button fx:id="btnExportCsv" text="Exportar CSV" />
                <Button fx:id="btnExportPdf" text="Exportar PDF" />
                <Button fx:id="btnExportAllCsv" text="Exportar todo (CSV)" />
                <Button fx:id="btnExportAllPdf" text="Exportar todo (PDF)" />
            </HBox>

            <TableView fx:id="tblReport" prefHeight="460">
            </TableView>
        </VBox>
    </center>

</BorderPane>
