<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.joshuamc1.inventariomunicipal.controllers.dashboard.OutcomesController">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Egresos" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refrescar" onAction="#onRefresh" />
            <Button text="Nuevo Egreso" onAction="#onNew" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="tblTransactions">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colProduct" text="Producto" prefWidth="200" />
                <TableColumn fx:id="colQuantity" text="Cantidad" prefWidth="100" />
                <TableColumn fx:id="colDate" text="Fecha" prefWidth="120" />
                <TableColumn fx:id="colPerson" text="Persona" prefWidth="180" />
                <TableColumn fx:id="colNotes" text="Notas" prefWidth="200" />
            </columns>
        </TableView>
    </center>
</BorderPane>

